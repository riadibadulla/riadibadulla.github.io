---
import type { CollectionEntry } from 'astro:content';
import { CRITERIA } from '../criteria';

interface Props {
  scores: CollectionEntry<'notes'>['data']['scores'];
  overall: number;
}

const { scores, overall } = Astro.props;
---

<table class="score-table">
  <caption>Scores against the seven review criteria (0 to 10)</caption>
  <thead>
    <tr>
      <th scope="col">Criterion</th>
      <th scope="col">Score</th>
      <th scope="col">Justification</th>
    </tr>
  </thead>
  <tbody>
    {
      CRITERIA.map(({ key, label }) => {
        const { score, justification } = scores[key];
        return (
          <tr>
            <th scope="row">{label}</th>
            {typeof score === 'number' ? (
              <td class="score">
                <strong>{score}</strong>/10
                <span class="meter" aria-hidden="true">
                  <span style={`width: ${score * 10}%`} />
                </span>
              </td>
            ) : (
              <td class="score na">Not assessable</td>
            )}
            <td>{justification}</td>
          </tr>
        );
      })
    }
  </tbody>
  <tfoot>
    <tr>
      <th scope="row">Overall</th>
      <td class="score">{overall}/10</td>
      <td></td>
    </tr>
  </tfoot>
</table>
