---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <div class="wrap page">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lede">The page may have moved when this site was rebuilt.</p>
      <p>Try the <a href="/">home page</a>, the <a href="/notes/">Technical Notes</a> or the <a href="/publications/">publications</a>.</p>
    </header>
  </div>
</Base>
